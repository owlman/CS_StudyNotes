{
    "mcp": {
        "github": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "<your github personal access token>"
            }
        },
        "gitee": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@gitee/mcp-gitee@latest"
            ],
            "environment": {
                "GITEE_API_BASE": "https://gitee.com/api/v5",
                "GITEE_ACCESS_TOKEN": "<your gitee access token>"
            }
        },
        "computer-use": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "computer-use-mcp"
            ]
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "fetch": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-server-fetch"
            ]
        },
        "git": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-server-git"
            ]
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "amap-maps": {
            "command": "npx",
            "args": ["-y", "@amap/amap-maps-mcp-server"],
            "env": {
                "AMAP_MAPS_API_KEY": "<您在高德开放平台上申请的key>"
            }
        },
        "12306-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "12306-mcp"
            ]
        }
    }
}
