{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Ninja + gcc, output to out/)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}