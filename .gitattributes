# ============================================================
# CS_StudyNotes 仓库级行尾规范化
# 统一 Markdown / 纯文本文件使用 LF 行尾，与 Obsidian 在所有
# 平台上的默认行为一致，避免在 Windows 上 git autocrlf=true
# 触发的 "LF will be replaced by CRLF" 警告。
#
# 建议本地仓库配置配合 core.autocrlf=input 使用（仅本机生效，不入库）：
#     git config core.autocrlf input
# 该配置下：commit 时 CRLF 自动转 LF，checkout 时保持原 LF，
# 与 Obsidian 的写入习惯完全一致，不再产生行尾警告。

*.md       text eol=lf
*.markdown text eol=lf
*.mdx      text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.py       text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.jsx      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.less     text eol=lf
*.html     text eol=lf
*.htm      text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf
*.csv      text eol=lf
*.tsv      text eol=lf
*.gitignore      text eol=lf
*.gitattributes   text eol=lf
*.editorconfig    text eol=lf
LICENSE   text eol=lf
README*   text eol=lf
# Git LFS：大体积二进制文件
# 论文 PDF 与 LLM 训练产物（adapter 权重、tokenizer）不再以普通 blob
# 写入仓库，改为 LFS 指针 + LFS 对象存储，避免后续每次提交都重复
# 打包几十 MB 的二进制。
#   注意：本节必须放在上面的 *.json text eol=lf 之后 —— 路径规则优先级
#   高于通配规则，才能让 tokenizer.json 走 LFS 而不被当成文本规范化。
*.pdf          filter=lfs diff=lfs merge=lfs -text
*.safetensors  filter=lfs diff=lfs merge=lfs -text
